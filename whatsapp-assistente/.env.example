# --- WhatsApp Business Cloud API (Meta) ---
# Token di accesso permanente (utente di sistema) dell'app Meta
WHATSAPP_TOKEN=
# "App secret" dell'app Meta: serve a verificare che i webhook arrivino davvero da Meta
WHATSAPP_APP_SECRET=
# Parola a scelta, da ripetere nella configurazione del webhook su Meta
WHATSAPP_VERIFY_TOKEN=scegli-una-parola-segreta
# ID del numero di telefono (Phone number ID) - serve solo per inviarti le notifiche
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Descrivi la tua attivita': aiuta Claude a capire cosa e' importante
BUSINESS_DESCRIPTION=GAC Impianti, ditta di impianti elettrici, videosorveglianza e automazioni

# --- Trascrizione vocali (locale, gratuita) ---
# tiny / base / small / medium / large-v3  (piu' grande = piu' preciso ma piu' lento)
WHISPER_MODEL=small
WHISPER_LANGUAGE=it

# --- Pannello web ---
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=cambiami
# Token per l'URL del calendario (.ics) da aggiungere a Google Calendar
CALENDAR_TOKEN=cambia-anche-questo

# --- Notifiche al titolare (facoltative) ---
# Tuo numero personale in formato internazionale senza + (es. 393331234567)
OWNER_WHATSAPP=
# Ora del riepilogo automatico serale inviato al tuo numero (vuoto = disattivato), es. 19:30
DIGEST_TIME=
# Secondi di attesa dopo l'ultimo messaggio prima di analizzare la chat
ANALYSIS_DEBOUNCE_SECONDS=90
TIMEZONE=Europe/Rome
DATA_DIR=./data
